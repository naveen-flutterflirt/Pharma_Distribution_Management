{
  "name": "pharma-distribution-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Pharma Distribution Management System (Pharma DMS) - Enterprise Monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "postinstall": "npm --prefix backend run db:generate",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "vercel-build": "npm --prefix backend run build",
    "start:frontend": "npm --prefix frontend run start",
    "start:backend": "npm --prefix backend run start",
    "start": "npm run start:backend & npm run start:frontend",
    "lint:frontend": "npm --prefix frontend run lint",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "db:generate": "npm --prefix backend run db:generate",
    "db:studio": "npm --prefix backend run db:studio",
    "test:flow": "node tests/browser_modules_connectivity_test.mjs",
    "test:e2e": "node tests/e2e_full_business_flow.mjs",
    "test:audit": "node tests/production_readiness_audit.mjs"
  },
  "keywords": [
    "pharma",
    "distribution",
    "management",
    "nextjs",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "Pharma DMS Team",
  "license": "ISC"
}
